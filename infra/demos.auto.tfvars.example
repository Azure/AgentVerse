# Demo deployment topology. Copy to demos.auto.tfvars (auto-loaded by Terraform).
#
# Each key is a stable demo_id that MUST match the demo's `name` in its
# agentverse.yaml (that is the link between deployment and catalog metadata).
# Paths are relative to the repo root. See docs/adding-a-demo.md for the full
# contract. Do NOT put secrets here — this file and the state are not a vault.
#
# Two ways to provide a demo's backing AI resources:
#   1. Shared (unified deploy): leave env largely empty and omit the `iac` hook.
#      The global stack (module.ai / module.cosmos / module.platform) injects the
#      endpoints, deployment names and AZURE_CLIENT_ID automatically at apply time
#      (see infra/locals.tf computed_env). This is what the live unified deploy uses.
#   2. Per-demo IaC (standalone): add an `iac` hook that runs the demo's own
#      Terraform/Bicep and fill the resulting endpoints into env yourself.
# The blocks below show mode 2; the injected values override any static env.

demos = {

  # -------------------------------------------------------------------------
  # FoundryAirlines — single container: FastAPI serves the UI and the API.
  # -------------------------------------------------------------------------
  foundryairlines-demo = {
    enabled = true

    services = [
      {
        name        = "web"
        context     = "src/foundryairlines-demo"
        dockerfile  = "src/foundryairlines-demo/Dockerfile"
        target_port = 8765
        is_web      = true
        external    = true
        min_replicas = 1
        max_replicas = 1
        # Non-secret endpoints produced by the demo's own Terraform (infra/main.tf).
        # Fill these in after the demo IaC has been applied.
        env = {
          # PROJECT_ENDPOINT      = "https://<foundry>.services.ai.azure.com/api/projects/<project>"
          # MODEL_DEPLOYMENT_NAME = "gpt-4.1"
          # BING_CONNECTION_NAME  = "bing-grounding"
          # IMAGE_ENDPOINT        = "https://<foundry>.openai.azure.com"
          # IMAGE_DEPLOYMENT      = "gpt-image-2"
        }
      },
    ]

    # Provisions Foundry account/project + model deployments (its own Terraform).
    iac = {
      type    = "terraform"
      command = "pwsh -NoProfile -Command \"Set-Location src/foundryairlines-demo/infra; terraform init; terraform apply -auto-approve\""
      notes   = "Bing grounding connection must be created once in the Foundry portal (manual)."
    }

    # Creates the three persistent prompt agents in the Foundry project
    # (flights-agent + events-agent via bootstrap_agents; activities-agent via
    # bootstrap_city_agents). Both bootstraps are idempotent upserts by name.
    registration = {
      type                = "python_module"
      command             = "pwsh -NoProfile -Command \"Set-Location src/foundryairlines-demo; python -m app.backend.bootstrap_agents; $a=$LASTEXITCODE; python -m app.backend.bootstrap_city_agents; $b=$LASTEXITCODE; if ($a -ne 0) { exit $a }; exit $b\""
      manual_prerequisite = true
      notes               = "Requires az login + app/.env filled with PROJECT_ENDPOINT. Bing connection is a manual portal step."
    }
  }

  # -------------------------------------------------------------------------
  # Insurance AI — two containers: FastAPI backend + React dashboard (web).
  # The dashboard's nginx proxies /api and /ws to the backend using
  # AGENTVERSE_INTERNAL_PREFIX (injected automatically).
  #
  # Disabled by default: its Bicep provisions APIM (~30 min) and is costly.
  # -------------------------------------------------------------------------
  insurance-ai-agents = {
    enabled = false

    services = [
      {
        name         = "backend"
        context      = "src/insurance-ai-agents"
        dockerfile   = "src/insurance-ai-agents/backend/Dockerfile"
        target_port  = 8000
        # Internal-only ingress: only the dashboard's nginx calls it (server-side),
        # never the browser. Keeping it internal also lets the nginx proxy reach it
        # over plain HTTP. external=true would force TLS and break app-to-app calls.
        external  = false
        transport = "http" # HTTP/1.1 so nginx proxy_pass + WebSocket upgrades work
        min_replicas = 1
        max_replicas = 2
        env = {
          USE_MAF_ORCHESTRATOR = "true"
          FRONTEND_URL         = "*"
          # AZURE_OPENAI_ENDPOINT / COSMOS_ENDPOINT / APPLICATIONINSIGHTS_CONNECTION_STRING
          # are injected by the unified deploy; set them here only for standalone IaC.
        }
      },
      {
        name         = "web"
        context      = "src/insurance-ai-agents/dashboard"
        dockerfile   = "src/insurance-ai-agents/dashboard/Dockerfile"
        target_port  = 8080
        is_web       = true
        external     = true
        min_replicas = 1
        max_replicas = 1
      },
    ]

    iac = {
      type    = "bicep"
      command = "pwsh -NoProfile -File src/insurance-ai-agents/scripts/deploy-infra.ps1"
      notes   = "Provisions APIM + Azure OpenAI + Cosmos. APIM first run is ~30 min."
    }

    # The insurance agents run in-process in the backend; the hosted Foundry
    # agent is optional. No automated registration step by default.
    registration = {
      type  = "manual"
      notes = "Optional hosted agent: src/insurance-ai-agents/agents/hosted/scripts/deploy.ps1"
    }
  }

  # -------------------------------------------------------------------------
  # Production Scheduling AI Agents — single container: FastAPI serves the
  # planner dashboard (Vanilla HTML/JS) and the API on the same port.
  #
  # Disabled by default: provisions an Azure AI Foundry account plus two model
  # deployments (gpt-4.1 for the orchestrator, gpt-5.4 for the simulator).
  # Without PROJECT_ENDPOINT the demo runs in deterministic replay mode, which
  # needs no Azure credentials and is safe for local development.
  # -------------------------------------------------------------------------
  production-scheduling-agents = {
    enabled = false

    services = [
      {
        name         = "web"
        context      = "src/production-scheduling-agents"
        dockerfile   = "src/production-scheduling-agents/Dockerfile"
        target_port  = 8000
        is_web       = true
        external     = true
        min_replicas = 1
        max_replicas = 1
        env = {
          # Non-secret endpoints produced by the demo's own Terraform.
          # Fill these in after the IaC has been applied (or leave unset for
          # replay/demo mode — the app works without a live Foundry project).
          # PROJECT_ENDPOINT                = "https://<foundry>.services.ai.azure.com/api/projects/<project>"
          # MODEL_DEPLOYMENT_NAME           = "gpt-4.1"
          # REASONING_MODEL_DEPLOYMENT_NAME = "gpt-5.4"
        }
      },
    ]

    # Provisions Azure AI Foundry account + the two model deployments.
    iac = {
      type    = "terraform"
      command = "pwsh -NoProfile -Command \"Set-Location src/production-scheduling-agents/infra; terraform init; terraform apply -auto-approve\""
      notes   = "Provisions Azure AI Foundry (AIServices) account, gpt-4.1 (chat) and gpt-5.4 (reasoning) deployments, App Insights."
    }
  }

  # -------------------------------------------------------------------------
  # Signal-to-Service — single container (FastAPI serves UI + SSE API on 8767).
  # Manufacturing predictive maintenance: telemetry anomaly -> diagnosis ->
  # SOP retrieval (RAG) -> human-in-the-loop approval -> work order + schedule.
  # Unified deploy uses the bundled local RAG (no Azure AI Search). Shared
  # Foundry endpoint + model + identity are injected by infra/locals.tf.
  # -------------------------------------------------------------------------
  signal-to-service = {
    enabled = true

    services = [
      {
        name         = "web"
        context      = "src/signal-to-service"
        dockerfile   = "src/signal-to-service/Dockerfile"
        target_port  = 8767
        is_web       = true
        external     = true
        min_replicas = 1
        max_replicas = 1
        env          = {}
      },
    ]

    registration = {
      type    = "python_module"
      command = "pwsh -NoProfile -Command \"Set-Location src/signal-to-service; python -m app.backend.bootstrap_agents\""
      notes   = "Creates the 3 prompt agents in the shared Foundry project. Needs az login + Azure AI Developer."
    }
  }

  # -------------------------------------------------------------------------
  # Model Evaluator — single container (FastAPI serves UI + JSON/SSE API on 8770).
  # A/B compares two Foundry-deployed chat models on one prompt in parallel
  # (latency / TTFT / tokens / throughput) with an optional blind LLM judge. The
  # model dropdowns are discovered at runtime from the shared Foundry project, so
  # newly deployed models appear automatically. PROJECT_ENDPOINT (discovery) and
  # AZURE_OPENAI_ENDPOINT (inference) are injected by infra/locals.tf; no model
  # name is pinned and there are no persistent agents (no registration block).
  # -------------------------------------------------------------------------
  model-evaluator = {
    enabled = true

    services = [
      {
        name         = "web"
        context      = "src/model-evaluator"
        dockerfile   = "src/model-evaluator/Dockerfile"
        target_port  = 8770
        is_web       = true
        external     = true
        min_replicas = 1
        max_replicas = 1
        env          = {}
      },
    ]
  }

  # -------------------------------------------------------------------------
  # Azure SRE Agent — single container (FastAPI serves UI + JSON API on 8780).
  # Guided replay of the Azure SRE Agent: deterministic, seeded incident
  # investigations (root cause + human-approved remediation) with WAF framing
  # and Microsoft Learn links. Ships in REPLAY mode — no live Azure calls, no
  # actions, no injected env needed, so the tab always renders at zero cost.
  # A read-only live path against a dedicated *sandbox* agent is scaffolded in
  # the backend (set SRE_AGENT_RESOURCE_ID); keep approvals/writes off in any
  # shared deploy. See src/sre-agent-demo/README.md.
  # -------------------------------------------------------------------------
  sre-agent-demo = {
    enabled = true

    services = [
      {
        name         = "web"
        context      = "src/sre-agent-demo"
        dockerfile   = "src/sre-agent-demo/Dockerfile"
        target_port  = 8780
        is_web       = true
        external     = true
        min_replicas = 1
        max_replicas = 1
        env          = {}
      },
    ]
  }

}
