# ─────────────────────────────────────────────────────────────────────────────
# {{Demo Title}} — environment template.
# Copy to .env and fill in the values. NEVER commit .env or real secrets.
# All model access goes through the gateway with DefaultAzureCredential — prefer
# managed identity / az login over API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Azure AI Foundry project ------------------------------------------------
# Format: https://<foundry-account>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-project>

# Chat model deployment used by the agents. Pick the smallest that passes evals.
MODEL_DEPLOYMENT_NAME=gpt-4.1

# ---- APIM AI Gateway (recommended) -------------------------------------------
# Route model calls through APIM for central rate limits, content safety, audit.
# Leave USE_APIM_GATEWAY=false to call Foundry directly during early development.
USE_APIM_GATEWAY=false
APIM_GATEWAY_URL=https://<your-apim>.azure-api.net
APIM_SUBSCRIPTION_KEY=<from-apim-portal>

# ---- Observability -----------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-app-insights-connection-string>

# ---- Backend -----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173        # for CORS
PORT=8000

# ---- Optional: hosted tools --------------------------------------------------
# If an agent uses a hosted tool (e.g. Bing Grounding), name its project connection.
# BING_CONNECTION_NAME=bing-grounding

# ---- Optional: extra models --------------------------------------------------
# IMAGE_ENDPOINT=https://<your-foundry-account>.openai.azure.com
# IMAGE_DEPLOYMENT=gpt-image-2
# IMAGE_API_VERSION=2025-04-01-preview

# ---- Optional: long-term memory (Cosmos DB) ----------------------------------
# Leave empty for in-memory / no-op. Auth is AAD-only (DefaultAzureCredential).
# COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
# COSMOS_DATABASE=<db>
# COSMOS_CONTAINER=<container>

# ---- Optional: auth (Entra ID) -----------------------------------------------
# AUTH_ENABLED=false (default): open demo. true: backend validates JWT.
# AUTH_ENABLED=false
# AUTH_TENANT_ID=<your-tenant-id>
# AUTH_CLIENT_ID=<your-app-registration-client-id>
