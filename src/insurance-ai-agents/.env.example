# Environment variables for the Insurance AI Demo
# Copy this file to .env and fill in the values after deploying infrastructure

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-openai-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_VOICE_DEPLOYMENT=gpt-realtime-mini

# gpt-5.4-mini is a reasoning model. By default it consumes reasoning tokens
# before every response, which adds 4-10 s of latency per agent.
# Values: minimal | low (default demo) | medium (default OpenAI) | high
# - "minimal" is the fastest but the model barely reasons and everything falls to
#   human_review (no contrast between decisions).
# - "low" is the balance we use: fast but correctly distinguishes approve / reject
#   / review.
OPENAI_REASONING_EFFORT=low

# Azure AI Services (Content Understanding, Speech, Translator, etc.)
AZURE_AI_SERVICES_ENDPOINT=https://<your-ai-services-name>.cognitiveservices.azure.com/

# Microsoft Agent Framework — modern orchestrator with token-level streaming
# If enabled, it tries MAF. If MAF fails, it automatically falls back to the legacy orchestrator.
USE_MAF_ORCHESTRATOR=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ── Cosmos DB (claims persistence) ───────────────────────────────────────
# If COSMOS_ENDPOINT is empty, the backend falls back to in-memory mode (no-op).
# Authentication is AAD-only (no keys) → DefaultAzureCredential is used.
# Make sure you have the "Cosmos DB Built-in Data Contributor" role on the account.
COSMOS_ENDPOINT=https://<your-cosmos-name>.documents.azure.com:443/
COSMOS_DATABASE=insurance-claims
COSMOS_CONTAINER=claims

# ── Microsoft Entra ID (customer/operator separation) ─────────────────────
# AUTH_ENABLED=false (default): open demo, no login.
# AUTH_ENABLED=true: backend validates JWT against the tenant; frontend requires login.
# Expected roles: Customer.Submit, Operator.Review.
AUTH_ENABLED=false
AUTH_TENANT_ID=<your-tenant-id>
AUTH_CLIENT_ID=<your-app-registration-client-id>

