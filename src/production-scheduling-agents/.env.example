# ─────────────────────────────────────────────────────────────────────────────
# Production Scheduling AI Agents — environment template.
# Copy to .env and fill in the values. NEVER commit .env or real secrets.
# All model access goes through the gateway with DefaultAzureCredential — prefer
# managed identity / az login over API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Azure AI Foundry project ------------------------------------------------
# Format: https://<foundry-account>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-project>

# Chat model deployment used by monitor / orchestrator / dispatcher agents.
MODEL_DEPLOYMENT_NAME=gpt-5.1
# Reasoning model deployment used by the scenario-simulator agent.
REASONING_MODEL_DEPLOYMENT_NAME=gpt-5.4

# ---- APIM AI Gateway (recommended) -------------------------------------------
# Route model calls through APIM for central rate limits, content safety, audit.
# Leave USE_APIM_GATEWAY=false to call Foundry directly during early development.
USE_APIM_GATEWAY=false
APIM_GATEWAY_URL=https://<your-apim>.azure-api.net
APIM_SUBSCRIPTION_KEY=<from-apim-portal>

# ---- Plant data sources (ERP / MES / IoT) -------------------------------------
# With USE_MOCK_DATA=true (default) the demo runs entirely on the bundled mock
# plant: a scripted order book, machine telemetry feed, and maintenance calendar.
# Point these at real (or sandbox) systems to integrate.
USE_MOCK_DATA=true
# ERP_API_URL=https://<your-erp>/api            # planned orders, forecasts, priorities
# MES_API_URL=https://<your-mes>/api            # machine status, WIP, changeovers
# IOT_EVENTHUB_CONNECTION=<event-hub-conn>      # machine telemetry stream
MOCK_DISRUPTION_INTERVAL_SECONDS=30             # how often the mock feed injects a disruption

# ---- Demo pacing ----------------------------------------------------------------
# In replay mode agent responses are instant; pace the SSE stream so the audience
# can watch the agents think. Seconds between agent events (0 = no pacing).
REPLAY_EVENT_DELAY=0.8

# ---- Scheduling behavior -------------------------------------------------------
# Above this confidence the orchestrator applies adjustments autonomously;
# below it, the decision is escalated to the planner (human-in-the-loop).
AUTO_APPLY_CONFIDENCE_THRESHOLD=0.8
MAX_SCENARIOS_PER_DISRUPTION=3

# ---- Observability -----------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-app-insights-connection-string>

# ---- Backend -----------------------------------------------------------------
FRONTEND_URL=http://localhost:5173        # for CORS
PORT=8000

# ---- Optional: auth (Entra ID) -----------------------------------------------
# AUTH_ENABLED=false (default): open demo. true: backend validates JWT.
# AUTH_ENABLED=false
# AUTH_TENANT_ID=<your-tenant-id>
# AUTH_CLIENT_ID=<your-app-registration-client-id>
