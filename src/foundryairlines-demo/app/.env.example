# ---- Foundry project ---------------------------------------------------
# Format: https://<foundry-account>.services.ai.azure.com/api/projects/<project-name>
PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-project>

# Chat model deployment used by both prompt agents
MODEL_DEPLOYMENT_NAME=gpt-4.1

# ---- Bing Grounding tool (Agent #2) ------------------------------------
# Name of the project connection that points at your Bing Grounding resource.
# Create it in the Foundry portal (Management center → Connected resources →
# + Connection → Grounding with Bing Search) — see README for the steps.
BING_CONNECTION_NAME=bing-grounding

# ---- gpt-image-2 (Agent #3) --------------------------------------------
# Same Foundry account exposes an Azure OpenAI endpoint where gpt-image-2
# is deployed. Format: https://<foundry-account>.openai.azure.com
IMAGE_ENDPOINT=https://<your-foundry-account>.openai.azure.com
IMAGE_DEPLOYMENT=gpt-image-2
IMAGE_API_VERSION=2025-04-01-preview

# ---- Optional agent name overrides -------------------------------------
# Defaults are sensible — change only if you want differently named agents
# in the Foundry portal.
# FLIGHTS_AGENT_NAME=flights-agent
# EVENTS_AGENT_NAME=events-agent
