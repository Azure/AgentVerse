# ---- Foundry project ---------------------------------------------------
# Format: https://<foundry-account>.services.ai.azure.com/api/projects/<project-name>
PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-project>

# Chat model deployment used by all three prompt agents
MODEL_DEPLOYMENT_NAME=gpt-4.1

# ---- RAG over SOP manuals ----------------------------------------------
# Leave AZURE_SEARCH_ENDPOINT empty to use the built-in local TF-IDF retriever
# (no Azure AI Search required to run locally). Set it to enable Azure AI Search.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=signal-to-service-sops

# ---- Optional agent name overrides -------------------------------------
# DIAGNOSIS_AGENT_NAME=signal-to-service-diagnosis-agent
# KNOWLEDGE_AGENT_NAME=signal-to-service-knowledge-agent
# ACTION_AGENT_NAME=signal-to-service-action-agent
